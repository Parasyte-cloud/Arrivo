# Copy to .env and point this at your running backend.
VITE_API_BASE_URL=http://localhost:4000

# Browser key for the Trip Tracker's Google map. In Google Cloud: enable "Maps JavaScript API" and
# "Routes API", then restrict the key by HTTP referrer to the Ops Console domain(s).
# Leave empty to use the basic OpenStreetMap map instead.
VITE_GOOGLE_MAPS_API_KEY=
