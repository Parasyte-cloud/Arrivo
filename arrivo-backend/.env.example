# Copy to .env and fill in real values. Never commit the real .env file.

PORT=4000

# PostgreSQL connection string. Free options: neon.tech or supabase.com
# (both have a permanent free tier — no 90-day expiry like some providers).
# Format: postgresql://user:password@host:port/database
# For local testing against a Postgres running on your own machine:
# postgresql://postgres:postgres@localhost:5432/arrivo_dev
DATABASE_URL=replace_me

# https://aviationstack.com — free tier available
AVIATIONSTACK_KEY=replace_me

# https://dashboard.paystack.com/#/settings/developer — use TEST keys until you go live
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_PUBLIC_KEY=pk_test_replace_me

# Where Paystack should send the user back after checkout (a page/deep link in your app)
PAYSTACK_CALLBACK_URL=https://arrivo.app/payment/callback

# Any long random string — used to sign login tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string

# OPTIONAL. Full URL (including path) to this backend's own email
# verification page, used in the "Verify Email" link sent on signup. Leave
# this commented out / unset — it now auto-detects the correct URL from
# whatever host actually received the signup request (localhost while
# developing locally, your real Render URL in production), so there's
# nothing to configure by default. Only set this if you want verification
# emails to link to a custom domain instead of the raw backend URL, e.g.:
# EMAIL_VERIFY_BASE_URL=https://api.ridearrivo.com/api/auth/verify-email
#
# IMPORTANT: if you do set this, use a real URL — NOT "replace_me" or any
# other placeholder. Unlike other keys in this file, this one is read with
# a plain `||` fallback (see routes/auth.js), so any non-empty value here,
# including a leftover placeholder, is used literally as the link.
# EMAIL_VERIFY_BASE_URL=

# https://console.twilio.com — used to send WhatsApp messages (driver/vehicle
# assignment details, flight cancellation/reschedule alerts, driver-changed
# notices). Twilio's WhatsApp Sandbox works immediately for testing (each
# recipient sends the sandbox's join code once from their own WhatsApp,
# shown on the Twilio console's WhatsApp sandbox page) — no Meta Business
# verification needed until you're ready to message people without that
# opt-in step, at which point you'd request a real WhatsApp Business number
# through Twilio and set TWILIO_WHATSAPP_FROM to it instead.
TWILIO_ACCOUNT_SID=replace_me
TWILIO_AUTH_TOKEN=replace_me
# Twilio's shared sandbox number — fine as-is for testing. Replace with your
# own approved WhatsApp Business number (format: whatsapp:+1XXXXXXXXXX) once
# you have one.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# https://console.cloud.google.com — a SEPARATE key from the one already
# live on ridearrivo.com's book.html (that one's a browser key restricted
# by HTTP referrer, no good here). Create a new key with "Places API" and
# "Distance Matrix API" enabled, and restrict it by server IP (under
# Credentials > your key > Application restrictions) rather than referrer,
# since there's no browser involved server-side. Powers /api/places/* and
# real distance-based fare calculation (see services/googleMaps.js).
GOOGLE_MAPS_SERVER_KEY=replace_me

# ── Google / Apple sign-in (services/oauth.js, routes/auth.js POST /google and /apple) ──
# Comma-separated list of every Google OAuth 2.0 Client ID allowed to mint
# tokens this backend accepts — one per platform, per app (rider + driver),
# so up to 6 total. Create these at https://console.cloud.google.com under
# "APIs & Services > Credentials > Create Credentials > OAuth client ID":
#   - Type "iOS" — needs each app's bundleIdentifier (com.arrivo.app / com.arrivo.driver)
#   - Type "Android" — needs each app's package name + the SHA-1 of the
#     keystore signing your build (same SHA-1 you already pulled for the
#     Google Maps API key restriction — `eas credentials` shows it)
#   - Type "Web application" — no restrictions needed. Two consumers use
#     this one: it's the harmless spare for Expo's AuthSession on mobile,
#     AND the actual client ID the website's login.html/signup.html use
#     directly via Google Identity Services (accounts.google.com/gsi/client)
#     for their own "Continue with Google" button.
# Paste the resulting client ID strings into each app's app.json under
# extra.googleOAuth, AND list every one of them here (this backend accepts
# any token whose audience matches one of these):
GOOGLE_OAUTH_CLIENT_IDS=replace_me_with_comma_separated_client_ids

# Comma-separated list of bundle IDs / Services IDs allowed as the audience
# for Apple identity tokens — the two app bundle IDs are already listed
# below. If you later set up "Sign In with Apple" for the website too (see
# APPLE_WEB_SERVICES_ID note in login.html/signup.html), add that Services
# ID string here as well, comma-separated. Requires an active Apple
# Developer Program membership. EAS Build manages the "Sign In with Apple"
# capability/entitlement automatically once each app's app.json has
# ios.usesAppleSignIn: true (already set) — no manual step in the Apple
# Developer portal should be needed for the mobile apps beyond having a
# paid membership on the account EAS builds under.
# These are the iOS bundle identifiers, which is what Apple puts in the token
# audience. They are NOT the Android package names: this used to read
# com.arrivo.app,com.arrivo.driver, which are the Android ones and can never
# appear in an Apple token, so Sign in with Apple would have failed on both
# iOS builds. Check these against ios.bundleIdentifier in each app.json.
APPLE_BUNDLE_IDS=com.ridearrivo.rider,com.ridearrivo.driver

# ArrivoNow on-demand ride dispatch.
# Keep false until backend, driver app and rider app have all passed QA.
ARRIVO_NOW_ENABLED=false

# ArrivoNow dispatch tuning.
# These affect driver matching only, not rider pricing.
ARRIVO_NOW_LOCATION_MAX_AGE_SECONDS=45
ARRIVO_NOW_OFFER_TTL_SECONDS=20
ARRIVO_NOW_INITIAL_RADIUS_KM=3
# Average city speed (km/h) used to turn "nearest driver is X km away" into the
# pickup time shown on the vehicle picker. Display only; 5 to 80, default 20.
ARRIVO_NOW_ETA_SPEED_KMH=20
ARRIVO_NOW_OFFER_BATCH_SIZE=3

# ── Sign in with Apple revocation (services/appleRevoke.js) ──
# Needed to DELETE an account that signed in with Apple. Clearing our own
# apple_id only makes us forget them: Apple still lists the app under the
# user's Sign in with Apple settings and still holds a live authorization.
# Apple requires the app to revoke it, and rejects builds that do not.
#
# Without these, deleting an Apple account answers 503 and tells the rider to
# contact support, rather than reporting success while the authorization is
# still live. Everyone else can still delete normally.
#
# Create the key at developer.apple.com under Certificates, Identifiers and
# Profiles > Keys, ticking "Sign in with Apple". Apple lets you download the
# .p8 exactly once, so keep it somewhere safe.
#
# APPLE_TEAM_ID      10 characters, top right of the developer portal
# APPLE_KEY_ID       10 characters, shown against the key you just made
# APPLE_PRIVATE_KEY  the whole .p8 file including the BEGIN/END lines, with
#                    newlines written as 
 since env vars cannot hold real ones
APPLE_TEAM_ID=replace_me
APPLE_KEY_ID=replace_me
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
replace_me
-----END PRIVATE KEY-----"
# No APPLE_CLIENT_ID here on purpose. Rider and driver are separate Apple
# clients, so a single value could only ever revoke one of the two. The
# client id is taken from the verified token at sign-in and stored on the
# user alongside the refresh token.

# ── App store review accounts (scripts/create-review-account.js) ──
# No default, on purpose. A password baked into a public repo is a working
# login for two real accounts. Supply one here or as the first argument.
REVIEW_ACCOUNT_PASSWORD=replace_me

# ── Panic paging (services/panicAlert.js) ──
# Who gets paged the moment a rider or driver presses the panic button.
# Comma-separated. Uses RESEND_API_KEY for email and the TWILIO_* settings
# above for WhatsApp. If both are empty, panics are only visible on the
# admin dashboard's Panic Alerts page, and every panic logs a loud error.
OPS_ALERT_EMAILS=
OPS_ALERT_WHATSAPP=

# Shared single sign-on across *.ridearrivo.com (see middleware/sessionCookie.js).
# Leading dot matters. Leave unset for local development (host-only cookie).
# The API must be served from inside ridearrivo.com (api.ridearrivo.com) or
# browsers will not accept this cookie.
SESSION_COOKIE_DOMAIN=
# SESSION_COOKIE_NAME=arrivo_session
# SESSION_COOKIE_SECURE=false   # only for plain-http local testing

# Extra browser origins allowed through CORS, comma separated, exact match
# (for example a Cloudflare Pages preview URL while testing a deploy).
EXTRA_ALLOWED_ORIGINS=

# Per-rider limits on ArrivoExpress, per 10 minutes, and the tolerance for a
# fare that rose between quote and confirm (percent).
# INSTANT_QUOTE_RATE_LIMIT=40
# INSTANT_CREATE_RATE_LIMIT=15
# INSTANT_FARE_TOLERANCE_PCT=10

# Origin lock (middleware/originLock.js). Only accept requests that came
# through Cloudflare, by checking a secret header that a Cloudflare Transform
# Rule adds. Leave off until the mobile apps use api.ridearrivo.com, because
# they currently call the Render hostname directly and would be refused.
#   off      does nothing (default)
#   report   lets everything through and logs "would block" lines
#   enforce  returns 403 without the secret header
# ORIGIN_LOCK_MODE=off
# ORIGIN_LOCK_SECRET=
# Paths that skip the check, comma separated (for example a webhook that
# the provider sends straight to the Render URL):
# ORIGIN_LOCK_EXEMPT=/api/payments/webhook
# ArrivoExpress pricing and driver quests (see docs/EXPRESS-PRICING-AND-QUESTS.md)
# Largest price change (percent) allowed in one publish without confirmLargeChange.
INSTANT_PRICE_MAX_CHANGE_PCT=25
# Largest worst-case cost (reward x max winners) of a single driver quest, in naira.
QUEST_MAX_BUDGET_NAIRA=2000000

# ArrivoExpress automation (both switches are OFF until an admin turns them on
# in Admin > ArrivoExpress Pricing > Automation)
# Most the automatic payout may credit to driver wallets in one Lagos day.
QUEST_AUTO_PAYOUT_DAILY_CAP_NAIRA=500000
# Automatic repricing guard rails
AUTO_REPRICE_MAX_STEP_PCT=5
AUTO_REPRICE_MIN_SAMPLES=8
AUTO_REPRICE_MIN_SOURCES=2
AUTO_REPRICE_WINDOW_DAYS=3
AUTO_REPRICE_COOLDOWN_HOURS=24
AUTO_REPRICE_BAND_MIN_PCT=70
AUTO_REPRICE_BAND_MAX_PCT=150
